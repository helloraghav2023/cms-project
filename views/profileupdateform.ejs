<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
        <link rel="stylesheet" href="css/style.css">
    
    </head>
<body>
    <%- include("../partials/header.ejs")%>

    <section id="profiles">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <h2><img style="width:200px;" src="/profileimages/<%=record.img%>" alt=""></a><%=record.email%>  Update profile</h2>
                    <p><%=message%></p>
                    <form action="" method="post" enctype="multipart/form-data">
                        <label for="">first name</label>
                        <input type="text" name="fname" id="" class="form-control" value="<%=record.firstName%>">
                        <label for="">last name</label>
                        <input type="text" name="lname" id="" class="form-control" value="<%=record.lastName%>" >
                        <label for="">mobile no</label>
                        <input type="number" name="mobile" id="" class="form-control" value="<%=record.mobile%>" >
                       <label for="">profile image</label>
                       <input type="file" name="img" id="" class="form-control">
                       <label for="">about you</label>
                       <textarea name="about" class="form-control"><%=record.desc%></textarea>
                                 
                        <button type="submit" class="form-control btn btn-info mt-2 mb-2">Update</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <%- include("../partials/footer.ejs")%>
</body>
</html>